{:paths ["src" "resources"]

 ;; The private registry. Declared HERE, not only in a developer's user-level
 ;; deps.edn, so a cold clone and CI resolve hive-agi artifacts identically.
 :mvn/repos {"hive-gitea" {:url "https://gitea.hive-mcp.com/api/packages/hive-agi/maven"}}

 :deps
 {org.clojure/clojure           {:mvn/version "1.12.5"}

  ;; hive-dsl — Result monad, error taxonomy
  io.github.hive-agi/hive-dsl   {:mvn/version "0.5.21"}

  ;; hive-addon — the IAddon protocol
  io.github.hive-agi/hive-addon {:mvn/version "1.0.0"}

  ;; hive-ingestor — the host whose source registry this addon registers into
  io.github.hive-agi/hive-ingestor {:mvn/version "0.2.151"}

  metosin/malli                 {:mvn/version "0.20.1"}
  com.taoensso/timbre           {:mvn/version "6.8.0"}}

 ;; hive-crawl is deliberately ABSENT: it is unpublished, and a fake
 ;; :mvn/version breaks cold resolution. It arrives through local.deps.edn,
 ;; and `frontier` resolves it lazily so the suite is green without it.

 :aliases
 {:build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.10"}}
          :ns-default hive-build.api}

  :test
  {:extra-paths ["test"]
   :extra-deps {lambdaisland/kaocha            {:mvn/version "1.91.1392"}
                io.github.hive-agi/hive-test   {:mvn/version "0.4.0"}
                io.github.hive-agi/hive-schemas {:mvn/version "0.1.29"}
                org.clojure/test.check         {:mvn/version "1.1.3"}}
   :main-opts ["-m" "kaocha.runner"]}

  :nrepl
  {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}
                cider/cider-nrepl {:mvn/version "0.62.2"}}
   :main-opts ["-m" "nrepl.cmdline"
               "--middleware" "[cider.nrepl/cider-middleware]"
               "--port" "7931"]}

  :dev
  {:extra-paths ["dev" "test"]
   :extra-deps {io.github.hive-agi/hive-test {:mvn/version "0.4.0"}
                org.clojure/test.check       {:mvn/version "1.1.3"}}}}}
