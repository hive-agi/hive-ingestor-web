{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure           {:mvn/version "1.12.6"}

  ;; hive-dsl — Result monad, error taxonomy
  io.github.hive-agi/hive-dsl   {:mvn/version "0.5.28"}

  ;; hive-addon — the IAddon protocol
  io.github.hive-agi/hive-addon {:mvn/version "1.0.11"}

  ;; hive-spi — the ingestion seam this addon fills: ISource, the owner-scoped
  ;; source registry, the Document value object, the conformance kit.
  io.github.hive-agi/hive-spi   {:mvn/version "1.1.1"}

  ;; hive-ingest-kit — body->document over the seam, shared by providers
  io.github.hive-agi/hive-ingest-kit {:mvn/version "0.1.4"}

  ;; hive-html — page HTML to text, headings and links, for the frontier
  io.github.hive-agi/hive-html  {:mvn/version "0.1.4"}

  metosin/malli                 {:mvn/version "0.20.1"}
  com.taoensso/timbre           {:mvn/version "6.8.0"}}

 ;; hive-crawl is deliberately ABSENT: it is unpublished, and a fake
 ;; :mvn/version breaks cold resolution. It arrives through local.deps.edn,
 ;; and `frontier` resolves it lazily so the suite is green without it.

 :aliases
 {:build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.18"}}
          :ns-default hive-build.api}

  :test
  {:extra-paths ["test"]
   :extra-deps {lambdaisland/kaocha            {:mvn/version "1.91.1392"}
                io.github.hive-agi/hive-test   {:mvn/version "0.4.6"}
                io.github.hive-agi/hive-schemas {:mvn/version "0.1.34"}
                org.clojure/test.check         {:mvn/version "1.1.3"}}
   :main-opts ["-m" "kaocha.runner"]}

  :nrepl
  {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}
                cider/cider-nrepl {:mvn/version "0.62.2"}}
   :main-opts ["-m" "nrepl.cmdline"
               "--middleware" "[cider.nrepl/cider-middleware]"
               "--port" "7931"]}

  :dev
  {:extra-paths ["dev" "test"]
   :extra-deps {io.github.hive-agi/hive-test {:mvn/version "0.4.6"}
                org.clojure/test.check       {:mvn/version "1.1.3"}}}}}
